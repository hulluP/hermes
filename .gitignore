# ═══════════════════════════════════════════════════════════════════════════════
# Hermes Agent — .gitignore
# Only custom configurations (profiles, skills, memories) should be tracked.
# All standard/bundled content is managed by `hermes update` and the curator.
# ═══════════════════════════════════════════════════════════════════════════════

# ── Secrets — never commit ────────────────────────────────────────────────────
auth.json
auth.lock
.env

# ── Databases ─────────────────────────────────────────────────────────────────
*.db
*.db-shm
*.db-wal

# ── Caches & transient state ──────────────────────────────────────────────────
cache/
audio_cache/
image_cache/
logs/
sandboxes/
sessions/
models_dev_cache.json
ollama_cloud_models_cache.json
gateway.lock
gateway_state.json

# ── Runtime artifacts (managed by hermes update) ──────────────────────────────
bin/
hermes-agent/
webui-mvp/
*.lock
request_dump_*.json

# ── Hermes internal bookkeeping ───────────────────────────────────────────────
.DS_Store
.clean_shutdown
.install_method
.update_check
.skills_prompt_snapshot.json

# ── Skills — ignore ALL bundled/downloaded, keep only custom ──────────────────
skills/*
!skills/domain/
!skills/productivity/
skills/productivity/*
!skills/productivity/sap-jira-mcp/

# ── Profiles — ignore bundled skills inside each profile ──────────────────────
# Keep profile definitions (SOUL.md, config.yaml) but ignore their skills copies
profiles/*/skills/
# Ignore runtime/state files inside profiles
profiles/*/.hermes_history
profiles/*/gateway.pid
profiles/*/channel_directory.json
profiles/*/tasks.json
profiles/*/plugins/

# ── Runtime config dir — mostly generated, ignore ─────────────────────────────
runtime/

# ── Plugin state (auto-generated) ────────────────────────────────────────────
plugins/

# ── Other generated/transient ─────────────────────────────────────────────────
cron/
pairing/
hooks/
channel_directory.json
tasks.json
*.pid
